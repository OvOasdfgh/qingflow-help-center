{
  "name": "qingflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run mdx:normalize && npm run routes:check && npm run assets:check && npm run build:index && docusaurus start",
    "build": "npm run mdx:normalize && npm run routes:check && npm run assets:check && npm run build:index && npm run build:site",
    "build:site": "docusaurus build",
    "build:index": "node ./scripts/generate-search-records.mjs",
    "assets:check": "node ./scripts/localize-doc-assets.mjs check",
    "assets:migrate": "node ./scripts/localize-doc-assets.mjs migrate",
    "assets:probe": "node ./scripts/localize-doc-assets.mjs probe",
    "assets:recover": "node ./scripts/localize-doc-assets.mjs recover",
    "mdx:normalize": "node ./scripts/normalize-mdx.mjs",
    "routes:check": "node ./scripts/manage-doc-routes.mjs check",
    "routes:migrate": "node ./scripts/manage-doc-routes.mjs migrate",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "search:push": "node ./scripts/push-typesense.mjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.3",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "@types/three": "^0.185.1",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
